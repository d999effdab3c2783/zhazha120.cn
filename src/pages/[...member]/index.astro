---
import { isNotNil } from 'es-toolkit'

import Page, { useMember } from '@/app/components/pages/home/index.vue'
import BaseLayout from '@/components/layouts/base.astro'
import { useMemberRoutes } from '@/utils/member'

export async function getStaticPaths() {
	return useMemberRoutes()
}

export type { Params, Props } from '@/pages/[...member]/_types/shared'
---

<BaseLayout>
	<Page
		client:visible
		member={isNotNil(Astro.props.member) ? useMember(Astro.props.member) : null}
	/>
</BaseLayout>